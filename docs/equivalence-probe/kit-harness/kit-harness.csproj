<Project Sdk="Microsoft.NET.Sdk">
  <!-- The capability kit's probe inputs (record-layouts.json, conditions.json) and callee contracts, built with the same
       code as CapabilityKitBuilder at publish (RecordKitBuilder, EquivalenceProbeInputs, CalleeContracts), for the
       standalone run ../run-fineract.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <!-- run-fineract.sh copies this project to work/ and passes the absolute path -->
    <KnowledgeProject Condition="'$(KnowledgeProject)' == ''">../../../MlCpu/src/MlCpu.CobolKb.Knowledge/MlCpu.CobolKb.Knowledge.csproj</KnowledgeProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KnowledgeProject)" />
  </ItemGroup>
</Project>
