<?xml version="1.0" encoding="UTF-8"?>
<entity-engine-xml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="{{ profile.host.dataDtd }}">
{{~ for r in model.demo ~}}
    <{{ r.entity }}{{ for a in r.attributes }} {{ a.name }}="{{ x.xml a.value }}"{{ end }}/>
{{~ end ~}}
</entity-engine-xml>
