        constant(r, "{{ r.layout }}", "{{ c.cobol }}", {{ c.offset }}, {{ c.length }}, "{{ c.value }}");
{{~ end ~}}
        String layout = "{{ r.layout }}";
        return new {{ r.name }}(
{{~ for f in r.fields ~}}
{{~ if f.decode == 'signedDecimal' || f.decode == 'unsignedDecimal' ~}}
                {{ f.decode }}(r, layout, "{{ f.cobol }}", {{ f.offset }}, {{ f.length }}, {{ f.scale }}){{ if !for.last }},{{ end }}
{{~ else ~}}
                {{ f.decode }}(r, layout, "{{ f.cobol }}", {{ f.offset }}, {{ f.length }}){{ if !for.last }},{{ end }}
{{~ end ~}}
{{~ end ~}}
