    /** A {{ r.layout }} record from a {{ r.name }}: the inverse of {{ r.decoder }} (bytes no field covers are spaces). */
    public static String encode({{ r.name }} x) {
        char[] c = new char[{{ x.upper_snake len }}_LENGTH];
        java.util.Arrays.fill(c, ' ');
        String layout = "{{ r.layout }}";
{{~ for k in r.constants ~}}
        put(c, layout, "{{ k.cobol }}", {{ k.offset }}, {{ k.length }}, "{{ k.value }}");
{{~ end ~}}
{{~ for f in r.fields ~}}
{{~ if f.decode == 'signedDecimal' || f.decode == 'unsignedDecimal' ~}}
        {{ f.decode }}Out(c, layout, "{{ f.cobol }}", {{ f.offset }}, {{ f.length }}, x.{{ f.name }}(), {{ f.scale }});
{{~ else ~}}
        {{ f.decode }}Out(c, layout, "{{ f.cobol }}", {{ f.offset }}, {{ f.length }}, x.{{ f.name }}());
{{~ end ~}}
{{~ end ~}}
        return new String(c);
    }
{{~ end ~}}
{{~ end ~}}

    private static void put(char[] c, String layout, String field, int offset, int length, String s) {
        if (s.length() != length) {
            throw new LegacyRecordException(layout, field, offset, s, "does not fit " + length + " characters");
        }
        s.getChars(0, length, c, offset);
    }

    private static void textOut(char[] c, String layout, String field, int offset, int length, String v) {
        String s = v == null ? "" : v;
        if (s.length() > length) {
            throw new LegacyRecordException(layout, field, offset, s, "longer than " + length + " characters");
        }
        put(c, layout, field, offset, length, s + " ".repeat(length - s.length()));
    }

    private static void idOut(char[] c, String layout, String field, int offset, int length, String v) {
        put(c, layout, field, offset, length, v);
    }

    private static void flagOut(char[] c, String layout, String field, int offset, int length, boolean v) {
        put(c, layout, field, offset, length, v ? "Y" : "N");
    }

    private static void dateOut(char[] c, String layout, String field, int offset, int length, LocalDate v) {
        put(c, layout, field, offset, length, v == null ? "00000000" : String.format("%04d%02d%02d", v.getYear(), v.getMonthValue(), v.getDayOfMonth()));
    }

    private static String zeros(String layout, String field, int offset, int length, BigInteger v) {
        String digits = v.abs().toString();
        if (digits.length() > length) {
            throw new LegacyRecordException(layout, field, offset, v.toString(), "more than " + length + " digits");
        }
        return "0".repeat(length - digits.length()) + digits;
    }

    private static void unsignedIntOut(char[] c, String layout, String field, int offset, int length, int v) {
        unsignedDecimalOut(c, layout, field, offset, length, BigDecimal.valueOf(v), 0);
    }

    private static void unsignedLongOut(char[] c, String layout, String field, int offset, int length, long v) {
        unsignedDecimalOut(c, layout, field, offset, length, BigDecimal.valueOf(v), 0);
    }

    private static void signedIntOut(char[] c, String layout, String field, int offset, int length, int v) {
        signedDecimalOut(c, layout, field, offset, length, BigDecimal.valueOf(v), 0);
    }

    private static void signedLongOut(char[] c, String layout, String field, int offset, int length, long v) {
        signedDecimalOut(c, layout, field, offset, length, BigDecimal.valueOf(v), 0);
    }

    private static void signedDecimalOut(char[] c, String layout, String field, int offset, int length, BigDecimal v, int scale) {
        BigInteger unscaled = exact(layout, field, offset, v, scale);
        put(c, layout, field, offset, length, (unscaled.signum() < 0 ? "-" : "+") + zeros(layout, field, offset, length - 1, unscaled));
    }

    private static void unsignedDecimalOut(char[] c, String layout, String field, int offset, int length, BigDecimal v, int scale) {
        BigInteger unscaled = exact(layout, field, offset, v, scale);
        if (unscaled.signum() < 0) {
            throw new LegacyRecordException(layout, field, offset, v.toPlainString(), "negative in an unsigned field");
        }
        put(c, layout, field, offset, length, zeros(layout, field, offset, length, unscaled));
    }

    private static BigInteger exact(String layout, String field, int offset, BigDecimal v, int scale) {
        try {
            return v.setScale(scale, java.math.RoundingMode.UNNECESSARY).unscaledValue();
        } catch (ArithmeticException e) {
            throw new LegacyRecordException(layout, field, offset, v.toPlainString(), "not exact at " + scale + " decimal places");
        }
    }

    private static void length(String r, int length, String layout) {
        if (r.length() != length) {
            throw new LegacyRecordException(layout, "(record)", 0, String.valueOf(r.length()), "a record of " + length + " characters expected");
        }
    }

    private static void constant(String r, String layout, String field, int offset, int length, String value) {
        String s = r.substring(offset, offset + length);
        if (!s.equals(value)) {
            throw new LegacyRecordException(layout, field, offset, s, "the record type is not " + value);
        }
    }

    private static String text(String r, String layout, String field, int offset, int length) {
        return r.substring(offset, offset + length).stripTrailing();
    }

    private static String id(String r, String layout, String field, int offset, int length) {
        return digits(r, layout, field, offset, length);
    }

    private static boolean flag(String r, String layout, String field, int offset, int length) {
        char c = r.charAt(offset);
        if (c != 'Y' && c != 'N') {
            throw new LegacyRecordException(layout, field, offset, String.valueOf(c), "not Y or N");
        }
        return c == 'Y';
    }

    private static String digits(String r, String layout, String field, int offset, int length) {
        String s = r.substring(offset, offset + length);
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) < '0' || s.charAt(i) > '9') {
                throw new LegacyRecordException(layout, field, offset, s, "not digits");
            }
        }
        return s;
    }

    private static int unsignedInt(String r, String layout, String field, int offset, int length) {
        return Integer.parseInt(digits(r, layout, field, offset, length));
    }

    private static long unsignedLong(String r, String layout, String field, int offset, int length) {
        return Long.parseLong(digits(r, layout, field, offset, length));
    }

    private static BigInteger signedDigits(String r, String layout, String field, int offset, int length) {
        char sign = r.charAt(offset);
        if (sign != '+' && sign != '-') {
            throw new LegacyRecordException(layout, field, offset, r.substring(offset, offset + length), "no leading sign");
        }
        BigInteger v = new BigInteger(digits(r, layout, field, offset + 1, length - 1));
        return sign == '-' ? v.negate() : v;
    }

    private static int signedInt(String r, String layout, String field, int offset, int length) {
        return signedDigits(r, layout, field, offset, length).intValueExact();
    }

    private static long signedLong(String r, String layout, String field, int offset, int length) {
        return signedDigits(r, layout, field, offset, length).longValueExact();
    }

    private static BigDecimal signedDecimal(String r, String layout, String field, int offset, int length, int scale) {
        return new BigDecimal(signedDigits(r, layout, field, offset, length), scale);
    }

    private static BigDecimal unsignedDecimal(String r, String layout, String field, int offset, int length, int scale) {
        return new BigDecimal(new BigInteger(digits(r, layout, field, offset, length)), scale);
    }

    private static LocalDate date(String r, String layout, String field, int offset, int length) {
        String s = digits(r, layout, field, offset, length);
        if ("00000000".equals(s)) {
            return null;
        }
        try {
            return LocalDate.of(Integer.parseInt(s.substring(0, 4)), Integer.parseInt(s.substring(4, 6)), Integer.parseInt(s.substring(6, 8)));
        } catch (DateTimeException e) {
            throw new LegacyRecordException(layout, field, offset, s, "not a date");
        }
    }
}
