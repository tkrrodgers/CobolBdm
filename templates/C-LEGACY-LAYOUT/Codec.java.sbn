    public static {{ r.name }} {{ r.decoder }}(String r) {
        length(r, {{ x.upper_snake r.decoder }}_LENGTH, "{{ r.layout }}");
        String kind = r.substring({{ r.discriminator.offset }}, {{ r.discriminator.offset + r.discriminator.length }});
        switch (kind) {
{{~ for c in r.discriminator.cases ~}}
{{~ for v in c.values ~}}
            case "{{ v }}":
{{~ end ~}}
                return {{ x.camel (c.record | string.replace 'Legacy' '') }}(r);
{{~ end ~}}
            default:
                throw new LegacyRecordException("{{ r.layout }}", "{{ r.discriminator.cobol }}", {{ r.discriminator.offset }}, kind, "not a record type of the layout");
        }
    }
{{~ else ~}}

    /** A {{ r.layout }} record{{ if r.parent }} of the variant {{ r.name }}{{ end }}. */
    public static {{ r.name }} {{ r.decoder }}(String r) {
{{~ if r.parent ~}}
{{~ for p in model.records ~}}
{{~ if p.name == r.parent ~}}
        length(r, {{ x.upper_snake p.decoder }}_LENGTH, "{{ r.layout }}");
{{~ for c in p.discriminator.cases ~}}
{{~ if c.record == r.name ~}}
        String kind = r.substring({{ p.discriminator.offset }}, {{ p.discriminator.offset + p.discriminator.length }});
        if (!{{ for v in c.values }}"{{ v }}".equals(kind){{ if !for.last }} && !{{ end }}{{ end }}) {
            throw new LegacyRecordException("{{ r.layout }}", "{{ p.discriminator.cobol }}", {{ p.discriminator.offset }}, kind, "not a record type of {{ r.name }}");
        }
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ else ~}}
