package {{ model.package }};

import java.math.BigDecimal;
import java.math.BigInteger;
import java.nio.charset.Charset;
import java.nio.charset.StandardCharsets;
import java.time.DateTimeException;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

/**
 * {{ model.title }}. Each decoder takes one record's characters (the dataset's bytes in {@link #CHARSET}, exactly the record's
 * length) and returns its Java record; a record that does not decode throws {@link LegacyRecordException}. Layouts: {{ model.layouts }}.
 */
public final class {{ model.codec }} {

    /** The datasets' character set: one byte per character. */
    public static final Charset CHARSET = StandardCharsets.ISO_8859_1;
{{~ for r in model.records ~}}
{{~ if !r.parent ~}}

    /** The length of a {{ r.layout }} record. */
    public static final int {{ x.upper_snake r.decoder }}_LENGTH = {{ r.length }};
{{~ end ~}}
{{~ end ~}}

    private {{ model.codec }}() {
    }

    /** The records of a fixed-length dataset (no separators between records). */
    public static List<String> records(byte[] dataset, int length) {
        if (dataset.length % length != 0) {
            throw new IllegalArgumentException("a dataset of " + dataset.length + " bytes is not a whole number of " + length + "-byte records");
        }
        List<String> out = new ArrayList<>(dataset.length / length);
        for (int i = 0; i < dataset.length; i += length) {
            out.add(new String(dataset, i, length, CHARSET));
        }
        return out;
    }

    /** The records of a dataset image kept one record per line: each line cut or padded with spaces to the length. */
    public static List<String> lines(String text, int length) {
        List<String> out = new ArrayList<>();
        for (String line : text.split("\n", -1)) {
            String l = line.endsWith("\r") ? line.substring(0, line.length() - 1) : line;
            if (l.isEmpty()) {
                continue;
            }
            out.add(l.length() >= length ? l.substring(0, length) : l + " ".repeat(length - l.length()));
        }
        return out;
    }
{{~ for r in model.records ~}}
{{~ if r.sealed ~}}

