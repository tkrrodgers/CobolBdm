package {{ model.package }};

/** A legacy record that does not decode: the layout, the field, its offset and the characters found there. */
public final class LegacyRecordException extends IllegalArgumentException {

    private static final long serialVersionUID = 1L;

    private final String layout;
    private final String field;
    private final int offset;
    private final String found;

    public LegacyRecordException(String layout, String field, int offset, String found, String problem) {
        super(layout + " " + field + " at offset " + offset + ": " + problem + " (found \"" + found + "\")");
        this.layout = layout;
        this.field = field;
        this.offset = offset;
        this.found = found;
    }

    public String layout() {
        return layout;
    }

    public String field() {
        return field;
    }

    public int offset() {
        return offset;
    }

    public String found() {
        return found;
    }
}
