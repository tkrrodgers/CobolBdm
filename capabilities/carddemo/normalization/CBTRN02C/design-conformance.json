  "deviations": [
    { "id": "D-01", "kind": "structure", "what": "Five design services became a validator, one posting service and the step's reject formatting.", "behaviour": "none (byte-identical outputs in every scenario)" },
    { "id": "D-02", "kind": "error handling", "what": "R-CBTRN02C-018: a failed account rewrite raises a DatasetException (step rc 20) instead of setting reason 109 and continuing.",
      "behaviour": "differs only in a state the program cannot reach (see the rule note)" }
  ],
  "implementationDefects": [
    { "id": "X-01", "status": "fixed", "fixedOn": "2026-10-06", "shared": ["CBACT04C"],
      "symptom": "ACCTDATA differed from the faithful program when positive amounts were stored with an unsigned zone (F-sign: a plain digit in the last byte instead of '{' or A-I).",
      "cause": "The account rewrite re-encoded every numeric field from the domain record. COBOL REWRITE changes only the fields the program assigned (ADD/MOVE); every other byte, including an unsigned zone in a credit limit, stays as stored.",
      "fix": "Account.post and Account.closeCycleWithInterest return an Account.Change naming the assigned balances; RecordLayouts.account(Change, stored) writes exactly those, canonically and even when the value is unchanged, and keeps every other stored byte. Category balance updates write only the balance over the stored image.",
      "exposedBy": ["positive numbers stored unsigned (F-sign)"],
      "guardedBy": ["F-sign with zero amounts"],
      "guardNote": "Re-verified 2026-10-06 by mutation: re-encoding every field fails both F-sign scenarios; writing only fields whose value changed fails 'F-sign with zero amounts' (COBOL ADD of zero still rewrites the field with a signed zone)." }
  ],
  "smeFindings": [
    { "id": "F-01", "severity": "low", "quirk": "Q-03",
      "finding": "When a transaction is both over limit and past expiry, only reason 103 is reported. The transaction is rejected either way; only the reported reason is lost.",
      "recommendation": "Keep for parity. Business to decide whether reject records should carry every failed check." }
  ]
