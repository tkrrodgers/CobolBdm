  "quirks": [
    { "quirkId": "Q-01", "designDisposition": "preserve", "implemented": "not observable",
      "note": "After a missing cross-reference the transaction is rejected with reason 100; the stale record is never used for output.", "verifiedBy": ["unknown cards (reason 100)"] },
    { "quirkId": "Q-02", "designDisposition": "preserve", "implemented": "not observable",
      "note": "After a missing account the transaction is rejected with reason 101; the stale account is never written.", "verifiedBy": ["accounts missing (reason 101)"] },
    { "quirkId": "Q-03", "designDisposition": "preserve", "implemented": "preserve",
      "implementation": "com.mlcpu.capabilities.transactionposting.TransactionValidator#limitAndExpiry",
      "note": "Both checks run; when both fail, the expiry reason (103) replaces the over-limit reason (102).", "verifiedBy": ["over limit and expired: 103 wins (Q-03)"] },
    { "quirkId": "Q-04", "designDisposition": "preserve", "implemented": "preserve",
      "implementation": "com.mlcpu.carddemo.data.FileRepositories#create",
