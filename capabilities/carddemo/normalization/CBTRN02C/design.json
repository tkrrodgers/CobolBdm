          "cobol": "X(10)"
        },
        {
          "name": "expirationDate",
          "type": "String",
          "cobol": "X(10)"
        },
        {
          "name": "reissueDate",
          "type": "String",
          "cobol": "X(10)"
        },
        {
          "name": "currentCycleCredit",
          "type": "BigDecimal",
          "cobol": "S9(10)V99"
        },
        {
          "name": "currentCycleDebit",
          "type": "BigDecimal",
          "cobol": "S9(10)V99"
        },
        {
          "name": "addressZip",
          "type": "String",
          "cobol": "X(10)"
        },
        {
          "name": "groupId",
          "type": "String",
          "cobol": "X(10)"
        }
      ]
    },
    {
      "name": "CardXrefRecord",
      "kind": "record",
      "source": "CARD-XREF-RECORD",
      "fields": [
        {
          "name": "cardNumber",
          "type": "String",
          "cobol": "X(16)"
        },
        {
          "name": "customerId",
          "type": "String",
          "cobol": "9(9)"
        },
        {
          "name": "accountId",
          "type": "String",
          "cobol": "9(11)"
        }
      ]
    },
    {
      "name": "TransactionCategoryBalanceRecord",
      "kind": "record",
      "source": "TRAN-CAT-BAL-RECORD",
      "fields": [
        {
          "name": "accountId",
          "type": "String",
          "cobol": "9(11)"
        },
        {
          "name": "typeCode",
          "type": "String",
          "cobol": "X(2)"
        },
        {
          "name": "categoryCode",
          "type": "String",
          "cobol": "9(4)"
        },
        {
          "name": "balance",
          "type": "BigDecimal",
          "cobol": "S9(9)V99"
        }
      ]
    },
    {
      "name": "RejectRecord",
      "kind": "record",
      "source": "FD-REJS-RECORD",
      "fields": [
        {
          "name": "originalRecord",
          "type": "String",
          "cobol": "X(350)"
        },
        {
          "name": "validationTrailer",
          "type": "String",
          "cobol": "X(80)"
        }
      ]
    },
    {
      "name": "ValidationFailureCode",
      "kind": "enum",
      "source": "N/A",
      "fields": [
        {
          "name": "NONE",
          "type": "int",
          "cobol": "0"
        },
        {
          "name": "INVALID_CARD",
          "type": "int",
          "cobol": "100"
        },
        {
          "name": "ACCOUNT_NOT_FOUND",
          "type": "int",
          "cobol": "101"
        },
        {
          "name": "OVERLIMIT",
          "type": "int",
          "cobol": "102"
        },
        {
          "name": "EXPIRED_ACCOUNT",
          "type": "int",
          "cobol": "103"
        },
        {
          "name": "ACCOUNT_REWRITE_FAIL",
          "type": "int",
          "cobol": "109"
        }
      ]
    }
  ],
  "ports": [
    {
      "name": "DalYtranReader",
      "kind": "reader",
      "file": "DALYTRAN-FILE",
      "methods": [
        "open",
        "readNext",
        "close"
      ]
    },
    {
      "name": "TransactionFileWriter",
      "kind": "writer",
      "file": "TRANSACT-FILE",
      "methods": [
        "open",
        "write",
        "close"
      ]
    },
    {
      "name": "XrefRepository",
      "kind": "repository",
      "file": "XREF-FILE",
      "methods": [
        "open",
        "findByCardNumber",
        "close"
      ]
    },
    {
      "name": "RejectFileWriter",
      "kind": "writer",
      "file": "DALYREJS-FILE",
      "methods": [
        "open",
        "write",
        "close"
      ]
    },
    {
      "name": "AccountRepository",
      "kind": "repository",
      "file": "ACCOUNT-FILE",
      "methods": [
        "open",
        "findByAccountId",
        "update",
        "close"
      ]
    },
    {
      "name": "CategoryBalanceRepository",
      "kind": "repository",
      "file": "TCATBAL-FILE",
      "methods": [
        "open",
        "find",
        "create",
        "update",
        "close"
      ]
    },
    {
      "name": "ConsolePort",
      "kind": "console",
      "file": "SYSOUT",
      "methods": [
        "display"
      ]
    },
    {
      "name": "ClockPort",
      "kind": "clock",
      "file": "SYSTEM-CLK",
      "methods": [
        "now"
      ]
    }
  ],
  "services": [
    {
      "name": "TransactionPostingService",
      "responsibility": "Orchestrates the whole posting workflow",
      "methods": [
        "run"
      ]
    },
    {
      "name": "ValidationService",
      "responsibility": "Performs XREF lookup and account validation",
      "methods": [
        "validate",
        "lookupXref",
        "lookupAccount",
        "checkLimits",
        "checkExpiration"
      ]
    },
    {
      "name": "PostingService",
      "responsibility": "Writes a validated transaction to the transaction file",
      "methods": [
        "postTransaction"
      ]
    },
    {
      "name": "BalanceUpdateService",
      "responsibility": "Updates transaction‑category balance and account balances",
      "methods": [
        "updateCategoryBalance",
        "updateAccount"
      ]
    },
    {
      "name": "RejectService",
      "responsibility": "Writes reject records when validation fails",
      "methods": [
        "writeReject"
      ]
    }
  ],
  "rules": [
    {
      "ruleId": "R-CBTRN02C-001",
      "disposition": "implemented",
      "element": "TransactionPostingService.run",
      "description": "Initialize counters and reset validation reason at start of each record loop",
      "reason": "Direct mapping of MAINLINE loop logic"
    },
    {
      "ruleId": "R-CBTRN02C-002",
      "disposition": "implemented",
      "element": "TransactionPostingService.run",
      "description": "Increment reject count when validation fails",
      "reason": "Corresponds to MAINLINE reject‑count increment"
    },
    {
      "ruleId": "R-CBTRN02C-003",
      "disposition": "implemented",
      "element": "TransactionPostingService.run",
      "description": "Set return‑code 4 when any rejects occurred",
      "reason": "Matches MAINLINE return‑code logic"
    },
