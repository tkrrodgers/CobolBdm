{
  "schema": "mlcpu.capability-design.v1",
  "programId": "CBTRN02C",
  "requirementsHash": "044b30b08318ba6a0c3ade1bdfcddb4e01f19669d1cc0508fdc9e3b8d8fe2f7c",
  "capability": "TransactionPosting",
  "package": "com.mlcpu.capabilities.transactionposting",
  "summary": "Posts daily transaction records to the transaction, account and category‑balance data sets, writes reject records and produces console diagnostics.",
  "domainModel": [
    {
      "name": "TransactionRecord",
      "kind": "record",
      "source": "DALYTRAN-RECORD / TRAN-RECORD",
      "fields": [
        {
          "name": "id",
          "type": "String",
          "cobol": "X(16)"
        },
        {
          "name": "typeCode",
          "type": "String",
          "cobol": "X(2)"
        },
        {
          "name": "categoryCode",
          "type": "String",
          "cobol": "9(4)"
        },
        {
          "name": "source",
          "type": "String",
          "cobol": "X(10)"
        },
        {
          "name": "description",
          "type": "String",
          "cobol": "X(100)"
        },
        {
          "name": "amount",
          "type": "BigDecimal",
          "cobol": "S9(9)V99"
        },
        {
          "name": "merchantId",
          "type": "String",
          "cobol": "9(9)"
        },
        {
          "name": "merchantName",
          "type": "String",
          "cobol": "X(50)"
        },
        {
          "name": "merchantCity",
          "type": "String",
          "cobol": "X(50)"
        },
        {
          "name": "merchantZip",
          "type": "String",
          "cobol": "X(10)"
        },
        {
          "name": "cardNumber",
          "type": "String",
          "cobol": "X(16)"
        },
        {
          "name": "origTimestamp",
          "type": "String",
          "cobol": "X(26)"
        },
        {
          "name": "procTimestamp",
          "type": "String",
          "cobol": "X(26)"
        }
      ]
    },
    {
      "name": "AccountRecord",
      "kind": "record",
      "source": "ACCOUNT-RECORD",
      "fields": [
        {
          "name": "accountId",
          "type": "String",
          "cobol": "9(11)"
        },
        {
          "name": "activeStatus",
          "type": "String",
          "cobol": "X(1)"
        },
        {
          "name": "currentBalance",
          "type": "BigDecimal",
          "cobol": "S9(10)V99"
        },
        {
          "name": "creditLimit",
          "type": "BigDecimal",
          "cobol": "S9(10)V99"
        },
