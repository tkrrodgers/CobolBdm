      "disposition": "implemented",
      "element": "ValidationService.lookupXref",
      "description": "Move card number into XREF key",
      "reason": "Straight copy of MOVE statement"
    },
    {
      "ruleId": "R-CBTRN02C-005",
      "disposition": "implemented",
      "element": "ValidationService.lookupXref",
      "description": "Set validation failure 100 on XREF NOT FOUND",
      "reason": "Implements INVALID KEY handling"
    },
    {
      "ruleId": "R-CBTRN02C-006",
      "disposition": "implemented",
      "element": "ValidationService.lookupAccount",
      "description": "Move account id from XREF to ACCOUNT key",
      "reason": "Direct mapping"
    },
    {
      "ruleId": "R-CBTRN02C-007",
      "disposition": "implemented",
      "element": "ValidationService.lookupAccount",
      "description": "Set validation failure 101 on ACCOUNT NOT FOUND",
      "reason": "Implements INVALID KEY handling"
    },
    {
      "ruleId": "R-CBTRN02C-008",
      "disposition": "implemented",
      "element": "ValidationService.lookupAccount",
      "description": "Compute temporary balance for limit check",
      "reason": "Corresponds to COMPUTE statement"
    },
    {
      "ruleId": "R-CBTRN02C-009",
      "disposition": "implemented",
      "element": "ValidationService.checkLimits",
      "description": "Set failure 102 when credit limit would be exceeded",
      "reason": "Implements over‑limit IF"
    },
    {
      "ruleId": "R-CBTRN02C-010",
      "disposition": "implemented",
      "element": "ValidationService.checkExpiration",
      "description": "Set failure 103 when transaction date after account expiration",
      "reason": "Implements expiration IF"
    },
    {
      "ruleId": "R-CBTRN02C-011",
      "disposition": "implemented",
      "element": "PostingService.postTransaction",
      "description": "Copy fields from DALYTRAN to TRAN record",
      "reason": "Direct field mapping"
    },
    {
      "ruleId": "R-CBTRN02C-012",
      "disposition": "implemented",
      "element": "PostingService.postTransaction",
      "description": "Populate PROC‑TS with DB2 formatted timestamp",
      "reason": "Matches MOVE DB2‑FORMAT‑TS"
    },
    {
      "ruleId": "R-CBTRN02C-013",
      "disposition": "implemented",
      "element": "RejectService.writeReject",
      "description": "Copy original record and validation trailer into reject record",
      "reason": "Direct mapping"
    },
    {
      "ruleId": "R-CBTRN02C-014",
      "disposition": "implemented",
      "element": "BalanceUpdateService.updateCategoryBalance",
      "description": "Prepare key fields for TCATBAL read/write",
      "reason": "Corresponds to MOVE statements"
    },
    {
      "ruleId": "R-CBTRN02C-015",
      "disposition": "implemented",
      "element": "BalanceUpdateService.updateCategoryBalance",
      "description": "Create new TCATBAL record when not found",
      "reason": "Implements INVALID KEY path"
    },
    {
      "ruleId": "R-CBTRN02C-016",
      "disposition": "implemented",
      "element": "BalanceUpdateService.updateCategoryBalance",
      "description": "Add transaction amount to existing balance",
      "reason": "ADD statement"
    },
    {
      "ruleId": "R-CBTRN02C-017",
      "disposition": "implemented",
      "element": "BalanceUpdateService.updateAccount",
      "description": "Add transaction amount to account current balance",
      "reason": "ADD statement"
    },
    {
      "ruleId": "R-CBTRN02C-018",
      "disposition": "implemented",
      "element": "BalanceUpdateService.updateAccount",
      "description": "Set failure 109 on account rewrite error",
      "reason": "Implements REWRITE INVALID KEY handling"
    },
    {
      "ruleId": "R-CBTRN02C-019",
      "disposition": "implemented",
      "element": "ClockPort.now",
      "description": "Build DB2 timestamp from CURRENT‑DATE",
      "reason": "Matches Z‑GET‑DB2‑FORMAT‑TIMESTAMP logic"
    }
  ],
  "quirks": [
    {
      "quirkId": "Q-01",
      "disposition": "preserve",
      "reason": "Stale XREF record on INVALID KEY must be retained for byte‑identical reject output",
      "element": "XrefRepository.findByCardNumber"
    },
    {
      "quirkId": "Q-02",
      "disposition": "preserve",
      "reason": "Stale ACCOUNT record on INVALID KEY must be retained for later balance calculations",
      "element": "AccountRepository.findByAccountId"
    },
    {
      "quirkId": "Q-03",
      "disposition": "preserve",
      "reason": "Last‑assignment‑wins semantics for WS‑VALIDATION‑FAIL‑REASON must be reproduced",
      "element": "ValidationService.validate"
    },
    {
      "quirkId": "Q-04",
      "disposition": "preserve",
      "reason": "Stale TCATBAL record on INVALID KEY must be kept to allow correct creation path",
      "element": "CategoryBalanceRepository.find"
    }
  ],
