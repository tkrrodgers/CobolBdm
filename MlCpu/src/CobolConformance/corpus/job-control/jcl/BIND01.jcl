//BIND01   JOB (ACCT),'DD BINDING'
//* Every DdBindingStatus: Bound, LengthMismatch, Dummy, NoDdInStep (REPORTF), UnresolvedSymbolic.
//STEP1    EXEC PGM=BINDPGM
//INFILE   DD DSN=BIND.IN,DISP=SHR,DCB=(RECFM=FB,LRECL=80)
//OUTFILE  DD DSN=BIND.OUT,DISP=(NEW,CATLG),DCB=(RECFM=FB,LRECL=100)
//AUDITF   DD DUMMY
//SYMF     DD DSN=&UNSET..FILE,DISP=SHR
//SYSOUT   DD SYSOUT=*
