<Project Sdk="Microsoft.NET.Sdk">
  <!--
    COBOL-85 parser generated by ANTLR 4.13.1 from grammars-v4 cobol85/Cobol85.g4 (ProLeap, MIT; commit 7535367, 2023-11-29).
    Regenerate: tools\Generate-CobolParser.ps1 (needs Java 21 and tools\antlr\antlr4-4.13.1-complete.jar).
    Local changes to the grammar (IBM Enterprise COBOL / COBOL 2002 constructs, SLL-friendly identifiers): docs\AST-GRAMMAR.md.
  -->
  <PropertyGroup>
    <RootNamespace>MlCpu.Cobol.Antlr</RootNamespace>
    <NoWarn>$(NoWarn);CS3021;CS0108;CS0618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MlCpu.CobolKb\MlCpu.CobolKb.csproj" />
    <ProjectReference Include="..\MlCpu.Cobol.Analysis\MlCpu.Cobol.Analysis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Grammar\Cobol85.g4" />
  </ItemGroup>
</Project>
