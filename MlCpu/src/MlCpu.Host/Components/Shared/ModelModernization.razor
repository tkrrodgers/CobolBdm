@using System.Text.Json.Nodes
@implements IDisposable
@inject ProjectService Projects
@inject WorkspaceActions Actions
@inject OperationService Ops
@inject JobParityService Parity

@* A local model's modernization of the active project (the Gemma 4 and Muse Glimmer pages): choose programs, design, publish the
   design to a service, test the service against GnuCOBOL. Compare is the other model, shown beside each program. *@

<PageTitle>@Model.Display Modernization</PageTitle>
<h2>@Model.Display Modernization</h2>

@if (Projects.Active is not { } p)
{
    <p>Select or onboard a project in <a href="settings">Settings</a>.</p>
}
else if (!Model.Published(p))
{
    <p>@Model.Display works on a published estate: publish @p.Name first (<a href="convert">Conversion → Publish</a>).</p>
}
else
{
    var caps = Model.Capabilities(p);
    var statuses = caps.ToDictionary(c => c.ProgramId, c => Model.Status(p, c.ProgramId));
    var others = Compare is null ? null : caps.ToDictionary(c => c.ProgramId, c => Compare.Status(p, c.ProgramId));
    var busy = Ops.IsRunning(p.Id, Model.DesignKind) || Ops.IsRunning(p.Id, Model.PublishKind);
    var state = Model.State(p);
    <p class="muted">@Model.Display (<code>@Path.GetFileName(Model.ModelPath)</code>, llama.cpp, local) works from the published estate
    <code>@p.Publish.Last!.Path</code> (published @p.Publish.Last.At[..16].Replace('T', ' ')): it designs each program from its requirements packet and
    COBOL-85 AST outline, implements its own design on the platform layer, and is judged by the program's equivalence test (normalized vs faithful
    in every scenario, and vs the GnuCOBOL oracle); compiler errors and every differing byte go back to it until it passes or the attempts run out.
    Settings: @Model.SettingsNote.</p>

    <div class="panel">
        <h3>1. Choose the COBOL programs</h3>
        <div class="row">
            <label>Number of programs</label>
            <input type="number" min="1" max="@caps.Count" @bind="count" style="width:5rem" />
            <button class="secondary" @onclick="() => SelectFirst(caps)">Select the first @count</button>
            <span class="muted">or tick them below</span>
        </div>
        <table class="grid">
            <tr><th></th><th>Program</th><th>Kind</th><th>Job</th><th>Entry class</th><th>Design</th><th>Implementation (equivalence test)</th>
                @if (Compare is not null) { <th>@Compare.Display (for comparison)</th> }</tr>
            @foreach (var c in caps)
            {
                var s = statuses[c.ProgramId];
                <tr class="@(chosen.Contains(c.ProgramId) ? "selected" : "")">
                    <td><input type="checkbox" checked="@chosen.Contains(c.ProgramId)" @onchange="e => Toggle(c.ProgramId, (bool)e.Value!)" /></td>
                    <td>@c.ProgramId</td><td>@c.Kind</td><td>@c.Job</td><td class="muted">@c.EntryClass</td>
                    <td>@if (!s.Designed) { <span class="muted">—</span> } else { <span class="@(s.DesignValid ? "ok" : "bad")">@(s.DesignValid ? "valid" : "invalid") (@s.DesignAttempts attempt(s)@(s.DesignMinutes is { } dm ? $", {dm:N1} min" : ""))</span> }</td>
                    <td><ImplementationCell Status="s" /></td>
                    @if (others is not null) { <td class="muted"><ImplementationCell Status="others[c.ProgramId]" /></td> }
                </tr>
            }
            @if (Compare is not null && (statuses.Values.Any(s => s.Implemented) || others!.Values.Any(s => s.Implemented)))
            {
                <tr><td></td><td colspan="5"><b>Total</b> <span class="muted">(programs passed, implementation attempts, minutes)</span></td>
                    <td><b>@Totals(statuses.Values)</b></td><td class="muted"><b>@Totals(others!.Values)</b></td></tr>
            }
        </table>
        <div class="row">
            <label>Options</label>
            <span>design attempts <input type="number" min="1" max="5" @bind="designAttempts" style="width:4rem" /></span>
            <span>implementation attempts <input type="number" min="1" max="30" @bind="implAttempts" style="width:4rem" /></span>
            <label style="min-width:auto"><input type="checkbox" @bind="astOutline" /> AST outline in the prompts</label>
            <label style="min-width:auto"><input type="checkbox" @bind="examples" /> worked examples + parity notes</label>
            <label style="min-width:auto" title="Once there is code that compiles, each repair turn sends a focused prompt (the contract, the COBOL the first divergence goes through, the current code, the scenarios to keep passing) with the ratchet; SEARCH/REPLACE edits only once at least half the scenarios pass"><input type="checkbox" @bind="debugMode" /> debug mode (focused repairs, ratchet, edits only)</label>
            <label style="min-width:auto" title="Begin from the model's best code of its last run (PID/java) instead of a first attempt"><input type="checkbox" @bind="warmStart" /> warm start from its last best code</label>
        </div>
    </div>

    <div class="panel">
        <h3>2. Design</h3>
        <div class="row">
            <button disabled="@(busy || chosen.Count == 0)" @onclick="() => Actions.StartModelDesign(Model, p.Id, Ordered(caps), Options())">Design @chosen.Count program(s) with @Model.Display</button>
            <span class="muted">one model load (under a minute), then one design per program (about 1–3 min each)</span>
        </div>
        <OperationPanel ProjectId="@p.Id" Kind="@Model.DesignKind" Completed="_ => Refresh()" Lines="25" />
        @foreach (var c in caps.Where(c => chosen.Contains(c.ProgramId) && statuses[c.ProgramId].Design is not null))
        {
            <DesignView ProgramId="@c.ProgramId" Design="@(statuses[c.ProgramId].Design!)" Valid="@statuses[c.ProgramId].DesignValid" />
        }
    </div>

    <div class="panel">
        <h3>3. Publish @Model.Display's design to the service</h3>
        <p class="muted">@Model.Display implements each valid design; every attempt is compiled in a harness (the published project without the
        capability's classes) and run against its equivalence test. The best attempt goes into a copy of the published project:
        <code>@Path.Combine(Model.Dir(p), "service")</code>.</p>
        <div class="row">
            <button disabled="@(busy || !chosen.Any(x => statuses.GetValueOrDefault(x)?.DesignValid == true))"
                    @onclick="() => Actions.StartModelPublish(Model, p.Id, Ordered(caps).Where(x => statuses[x].DesignValid).ToList(), Options())">Publish design to service</button>
            @if (state.ServicePath is { } sp) { <span class="muted">service: <code>@sp</code></span> }
            @if (Model.HasCode(p)) { <a href="@Model.CodePage">View @Model.Display's code</a> }
        </div>
        <OperationPanel ProjectId="@p.Id" Kind="@Model.PublishKind" Completed="_ => Refresh()" Lines="30" />
    </div>

    <div class="panel">
        <h3>4. Test the service — GnuCOBOL as the oracle</h3>
        <p class="muted">Every test of the service, then each job run with <code>--mlcpu.implementation=normalized</code> (@Model.Display's code for its
        programs) and every output compared byte for byte with the GnuCOBOL oracle.</p>
        <div class="row">
            <button disabled="@(state.ServicePath is null || Ops.IsRunning(p.Id, Model.TestKind))" @onclick="() => Actions.StartModelTest(Model, p.Id)">Test with GnuCOBOL</button>
        </div>
        <OperationPanel ProjectId="@p.Id" Kind="@Model.TestKind" Completed="_ => Refresh()" Lines="20" />
        @if (state.ServicePath is not null && Parity.LastReport(p, Model.Id) is { } report) { <TestReport Report="report" /> }
    </div>
}

@code {
    /// <summary>The model this page runs.</summary>
    [Parameter, EditorRequired] public ModelRunService Model { get; set; } = default!;
    /// <summary>The other model, whose results on the same programs are shown beside this one's.</summary>
    [Parameter] public ModelRunService? Compare { get; set; }

    readonly HashSet<string> chosen = new(StringComparer.OrdinalIgnoreCase);
    int count = 1, designAttempts = 3, implAttempts = 15;
    bool astOutline = true, examples = true, debugMode, warmStart;
    string? loadedFor;

    protected override void OnInitialized()
    {
        Projects.Changed += Refresh;
        var d = Model.Defaults;
        (designAttempts, implAttempts, astOutline, examples, debugMode, warmStart) =
            (d.DesignAttempts, d.ImplementationAttempts, d.AstOutline, d.WorkedExamples, d.DebugMode, d.WarmStart);
    }

    protected override void OnParametersSet()
    {
        if (Projects.Active is { } p && loadedFor != p.Id)
        {
            loadedFor = p.Id;
            chosen.Clear();
            var caps = Model.Capabilities(p);
            foreach (var c in caps.Where(c => Model.Status(p, c.ProgramId).Designed)) chosen.Add(c.ProgramId);
            if (chosen.Count == 0 && caps.Count > 0) chosen.Add(caps[0].ProgramId);
            count = Math.Max(1, chosen.Count);
        }
    }

    ModelOptions Options() => new(designAttempts, implAttempts, astOutline, examples, debugMode, warmStart);

    List<string> Ordered(IReadOnlyList<GemmaCapability> caps) => caps.Select(c => c.ProgramId).Where(chosen.Contains).ToList();

    static string Totals(IEnumerable<GemmaProgramStatus> all)
    {
        var done = all.Where(s => s.Implemented).ToList();
        if (done.Count == 0) return "—";
        var passed = done.Count(s => s.Compiled && s.TestsTotal > 0 && s.TestsPassed == s.TestsTotal);
        var minutes = done.Sum(s => s.Minutes ?? 0);
        return $"{passed}/{done.Count} passed, {done.Sum(s => s.Attempts)} attempts, {minutes:N1} min";
    }

    void SelectFirst(IReadOnlyList<GemmaCapability> caps)
    {
        chosen.Clear();
        foreach (var c in caps.Take(Math.Clamp(count, 1, caps.Count))) chosen.Add(c.ProgramId);
    }

    void Toggle(string pid, bool on)
    {
        if (on) chosen.Add(pid); else chosen.Remove(pid);
        count = Math.Max(1, chosen.Count);
    }

    void Refresh() => InvokeAsync(() => { OnParametersSet(); StateHasChanged(); });

    public void Dispose() => Projects.Changed -= Refresh;
}
